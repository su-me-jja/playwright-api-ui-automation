{
  "name": "playwright-api-ui-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI, API, and end-to-end QA automation",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:list": "playwright test --list --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
